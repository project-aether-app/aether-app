root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 2
ktlint_function_naming_ignore_when_annotated_with=Composable
ij_kotlin_function_naming_allow_pascal_case_for_composables = true

[*.py]
indent_style = space
indent_size = 4

[*.xml]
indent_style = tab
